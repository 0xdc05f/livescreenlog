# Copy to .env and fill real values before:
#   docker compose -f docker-compose.yml --env-file .env up -d
# Never commit a real .env.

# --- Application (required) ---
LIVESCREENLOG_HMAC_SECRET=replace-with-a-long-random-hmac-value-at-least-32-chars
LIVESCREENLOG_ALLOWED_CAPTURE_ORIGINS=https://app.example.com,https://admin.example.com
LIVESCREENLOG_RETENTION_DAYS=30

# Dashboard (enabled for air-gap bootstrap)
LIVESCREENLOG_DASHBOARD_ENABLED=true
LIVESCREENLOG_DASHBOARD_USERNAME=admin
LIVESCREENLOG_DASHBOARD_PASSWORD=replace-with-strong-password

# --- Database / Redis (compose service names) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=livescreenlog
DB_USER=livescreenlog_user
DB_PASSWORD=replace-db-credential-12
REDIS_HOST=valkey
REDIS_PORT=6379
