# copy: cp env.example /data/livescreenlog/env/env.dev
# chmod 600

DB_HOST=postgres
DB_PORT=5432
DB_NAME=livescreenlog
DB_USER=livescreenlog_user
DB_PASSWORD=replace-db-password-min-12-chars

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 0.3.2 uses LIVESCREENLOG_SECURITY_* for hmac/origins/dashboard.
# SECURITY_ 없는 동일 이름(LIVESCREENLOG_HMAC_SECRET, LIVESCREENLOG_ALLOWED_CAPTURE_ORIGINS, LIVESCREENLOG_DASHBOARD_*)은 기동 실패.
# First login password is printed once in docker logs as FIRST BOOT.
LIVESCREENLOG_SECURITY_HMAC_SECRET=replace-with-a-long-random-hmac-value-at-least-32-chars
LIVESCREENLOG_SECURITY_ALLOWED_CAPTURE_ORIGINS=http://127.0.0.1:8080,http://10.200.6.135:8080
# prod 프로필에서 * 금지. 브라우저 origin만 콤마로.

LIVESCREENLOG_SECURITY_DASHBOARD_ENABLED=true
LIVESCREENLOG_SECURITY_DASHBOARD_USERNAME=admin
LIVESCREENLOG_SECURITY_DASHBOARD_PASSWORD=replace-with-strong-password-12plus
SPRING_PROFILES_ACTIVE=prod
LIVESCREENLOG_RETENTION_DAYS=30

LOGGING_FILE_PATH=/data/livescreenlog/logs
LOGGING_FILE_NAME=/data/livescreenlog/logs/livescreenlog.log
